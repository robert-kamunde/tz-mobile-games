{
  "name": "@tzg/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phaser app shell shared by both games: boot, scaling, lifecycle, settings, language. Contains no gameplay.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
