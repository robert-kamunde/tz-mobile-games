    "test:e2e": "npm run build:e2e && playwright test"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@tzg/core": "0.1.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "vite": "8.3.3"
  }
}
