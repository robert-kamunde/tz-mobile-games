{
  "name": "tz-mobile-games",
  "private": true,
  "type": "module",
  "description": "Two mobile games for the Tanzanian market (Pool, Daladala Rush) sharing one core.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @tzg/shell -w @tzg/pool",
    "dev:shell": "npm run dev -w @tzg/shell",
    "check": "npm run typecheck && npm run test && npm run test:e2e",
    "dev:pool": "npm run dev -w @tzg/pool"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
